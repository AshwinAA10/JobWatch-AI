# ==============================================================================
# JobWatch AI — Production & Deployment Environment Reference Template
# ==============================================================================
# Copy this file to .env before starting development:
#   cp .env.example .env
#
# Production deployments MUST supply secure environment variables through the
# hosting provider's secrets manager (e.g. Render, Railway, Vercel, or AWS SSM).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION METADATA & RUNTIME
# ------------------------------------------------------------------------------
APP_NAME=JobWatch AI
# Options: development, testing, production
APP_ENV=development
APP_VERSION=0.1.0
# MUST BE false IN PRODUCTION (enforced by startup validation)
DEBUG=true

# Backend Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 2. CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of origins permitted to communicate with the API.
# In production, specify explicit domain(s) (e.g. https://app.jobwatch.ai).
# Wildcard '*' is strictly prohibited in production when credentials are used.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend API URL (bundled into React build at compile time)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (POSTGRESQL + PGVECTOR)
# ------------------------------------------------------------------------------
# Production connection string using psycopg 3 (must include sslmode=require if remote):
DATABASE_URL=postgresql+psycopg://jobwatch:jobwatch_dev@localhost:5432/jobwatch
# Docker container database URL targeting host Windows PostgreSQL:
DOCKER_DATABASE_URL=postgresql+psycopg://jobwatch:jobwatch_dev@host.docker.internal:5432/jobwatch
TEST_DATABASE_URL=

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
DB_ECHO=false

# Docker Compose Local PostgreSQL Settings
POSTGRES_USER=jobwatch
POSTGRES_PASSWORD=jobwatch_dev
POSTGRES_DB=jobwatch
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# In production, JWT_SECRET must be at least 32 characters with high entropy.
# Startup validation rejects default development keys in production.
AUTH_ENABLED=true
JWT_SECRET=dev-insecure-jwt-secret-key-change-in-production-min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting (Phase 11)
RATE_LIMIT_ENABLED=false
AUTH_RATE_LIMIT_PER_MINUTE=15
API_RATE_LIMIT_PER_MINUTE=120

# ------------------------------------------------------------------------------
# 5. MONITORING & INGESTION ENGINE
# ------------------------------------------------------------------------------
MONITORING_ENABLED=false
MONITORING_INTERVAL_SECONDS=900
MONITORING_MAX_CONCURRENCY=5
MONITORING_MAX_RETRIES=2
MONITORING_RETRY_BACKOFF_SECONDS=5.0
MONITORING_SOURCE_TIMEOUT_SECONDS=120.0

# Deduplication Configuration
DEDUP_ENABLED=true
DEDUP_HIGH_THRESHOLD=0.90
DEDUP_MEDIUM_THRESHOLD=0.75
DEDUP_MAX_CANDIDATES=100
DEDUP_LOOKBACK_DAYS=90

# ------------------------------------------------------------------------------
# 6. AI INTELLIGENCE & SEMANTIC MATCHING
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
OPENAI_TIMEOUT=30.0
OPENAI_MAX_RETRIES=2

AI_EXTRACTION_ENABLED=true
AI_EMBEDDING_ENABLED=true
AI_HYBRID_MATCHING_ENABLED=true
AI_EXPLANATIONS_ENABLED=true
HYBRID_DETERMINISTIC_WEIGHT=0.70
HYBRID_SEMANTIC_WEIGHT=0.30

# ------------------------------------------------------------------------------
# 7. NOTIFICATION & ALERTING SUBSYSTEM
# ------------------------------------------------------------------------------
NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@jobwatch.ai
SMTP_FROM_NAME=JobWatch AI
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10.0
EMAIL_REQUIRE_VERIFIED=false

WEBHOOK_NOTIFICATIONS_ENABLED=false
WEBHOOK_TIMEOUT_SECONDS=10.0
NOTIFICATION_MAX_RETRIES=4
NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=600
NOTIFICATION_HOURLY_RATE_LIMIT=10
NOTIFICATION_DEFAULT_MIN_SCORE=75.0
