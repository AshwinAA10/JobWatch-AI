# ==============================================================================
# JobWatch AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting development:
#   cp .env.example .env
#
# Variables are separated into:
#   1. Current Active (Phase 0 & Phase 1)
#   2. Future (Phases 2-13 placeholders - not currently active)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CONFIGURATION (ACTIVE)
# ------------------------------------------------------------------------------
APP_NAME=JobWatch AI
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1

# CORS Settings (comma-separated list of origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Server
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PHASE 1 ACTIVE)
# ------------------------------------------------------------------------------
# Local PostgreSQL / Docker PostgreSQL connection string using psycopg 3:
DATABASE_URL=postgresql+psycopg://jobwatch:jobwatch_dev@localhost:5432/jobwatch
TEST_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Docker Compose PostgreSQL Settings
POSTGRES_USER=jobwatch
POSTGRES_PASSWORD=jobwatch_dev
POSTGRES_DB=jobwatch
POSTGRES_PORT=5432


# ------------------------------------------------------------------------------
# 3. FUTURE PHASES (PLACEHOLDERS - DO NOT ENABLE IN PHASE 1)
# ------------------------------------------------------------------------------

# Phase 3 & 4: Queue / Cache / Background Workers
# REDIS_URL=redis://localhost:6379/0

# Phase 5: Security & Authentication
# SECRET_KEY=change_this_to_a_secure_random_string_in_production
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Phase 7 & 13: AI & LLM Providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# Phase 8: Notification Providers
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
